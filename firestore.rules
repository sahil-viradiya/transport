rules_version = '2';

// Security model for the individual-truck-owner app.
//
// Identity = the phone number issued by Firebase Phone Auth
// (request.auth.token.phone_number, E.164 e.g. +919876543210). This is the same
// value the app uses as `ownerKey`, so every owner can only touch documents that
// carry their own phone as the id (drivers/users) or as the `ownerId` field
// (trips/trucks/expenses). An optional `admin` role can see everything.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null && request.auth.token.phone_number != null;
    }

    function phone() {
      return request.auth.token.phone_number;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(phone()))
        && get(/databases/$(database)/documents/users/$(phone())).data.role == 'admin';
    }

    function ownsIncoming() {
      return request.resource.data.ownerId == phone();
    }

    function ownsExisting() {
      return resource.data.ownerId == phone();
    }

    // Login directory — each user owns their own row. An admin must also be
    // able to REGISTER other people (add a driver) and change their role, so
    // create/update is allowed for admins too — without this, "Add Driver"
    // silently fails because the admin is writing users/{driverPhone}, which
    // is not their own id.
    match /users/{phoneId} {
      allow read:           if isSignedIn() && (phoneId == phone() || isAdmin());
      allow create, update: if isSignedIn() && (phoneId == phone() || isAdmin());
      allow delete:         if isAdmin();
    }

    // Owner profile (license, vehicle, emergency contact, documents, location).
    match /drivers/{ownerId} {
      allow read, write: if isSignedIn() && (ownerId == phone() || isAdmin());
    }

    // Trips, trucks, expenses — private to the owner named in `ownerId`.
    match /trips/{tripId} {
      allow read:   if isSignedIn() && (ownsExisting() || isAdmin());
      allow create: if isSignedIn() && (ownsIncoming() || isAdmin());
      allow update: if isSignedIn() && (ownsExisting() || isAdmin());
      allow delete: if isSignedIn() && (ownsExisting() || isAdmin());
    }

    match /trucks/{truckId} {
      allow read:   if isSignedIn() && (ownsExisting() || isAdmin());
      allow create: if isSignedIn() && (ownsIncoming() || isAdmin());
      allow update: if isSignedIn() && (ownsExisting() || isAdmin());
      allow delete: if isSignedIn() && (ownsExisting() || isAdmin());
    }

    match /expenses/{expenseId} {
      allow read:   if isSignedIn() && (ownsExisting() || isAdmin());
      allow create: if isSignedIn() && (ownsIncoming() || isAdmin());
      allow update: if isSignedIn() && (ownsExisting() || isAdmin());
      allow delete: if isSignedIn() && (ownsExisting() || isAdmin());
    }

    // Vendors — a shared master list (pickup points / material suppliers) that
    // the admin maintains and every signed-in driver reads while a trip is
    // being assigned. This block was missing entirely, so `vendors` fell
    // through to the default deny and the dashboard reported permission-denied.
    match /vendors/{vendorId} {
      allow read:  if isSignedIn();
      allow write: if isAdmin();
    }

    // Notifications — a user reads only their own (toPhone == their phone) and
    // may mark them read. Any signed-in user can create one addressed to
    // someone else (e.g. driver ⇄ admin trip updates).
    match /notifications/{noteId} {
      allow read:   if isSignedIn() && resource.data.toPhone == phone();
      allow create: if isSignedIn() && request.resource.data.toPhone is string;
      allow update: if isSignedIn() && resource.data.toPhone == phone();
      allow delete: if isSignedIn() && resource.data.toPhone == phone();
    }

    // App-wide config — readable by any signed-in user, writable by admin only.
    match /system/{doc} {
      allow read:  if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
