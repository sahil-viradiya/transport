rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null &&
             request.auth.token.phone_number != null;
    }

    function phone() {
      return request.auth.token.phone_number.replace('^\\+', '');
    }

    function checkUserRole(phoneId, expectedRole) {
      return exists(/databases/$(database)/documents/users/$(phoneId))
        && get(/databases/$(database)/documents/users/$(phoneId)).data.role == expectedRole;
    }

    function isAdmin() {
      return isSignedIn() && (
        checkUserRole(phone(), 'admin') ||
        checkUserRole(phone().replace('^91', ''), 'admin')
      );
    }

    function isPhoneMatch(dbPhone) {
      return dbPhone != null && (
        dbPhone.replace('^\\+', '') == phone() ||
        dbPhone.replace('^\\+91', '') == phone().replace('^91', '') ||
        '91' + dbPhone.replace('^\\+', '') == phone() ||
        dbPhone.replace('^\\+', '') == '91' + phone()
      );
    }

    function ownsIncoming() {
      return request.resource.data.keys().hasAll(['ownerId']) &&
             isPhoneMatch(request.resource.data.ownerId);
    }

    function ownsExisting() {
      return resource != null &&
             resource.data.keys().hasAll(['ownerId']) &&
             isPhoneMatch(resource.data.ownerId);
    }

    // =========================
    // USERS
    // =========================
    match /users/{phoneId} {
      allow read:
          if isSignedIn() &&
          (isPhoneMatch(phoneId) ||
           resource.data.role == 'admin' ||
           isAdmin());

      allow create, update:
          if isSignedIn() &&
          (isPhoneMatch(phoneId) || isAdmin());

      allow delete:
          if isAdmin();
    }

    // =========================
    // DRIVERS
    // =========================
    match /drivers/{ownerId} {
      allow read, write:
          if isSignedIn() &&
          (isPhoneMatch(ownerId) || isAdmin());
    }

    // =========================
    // TRIPS
    // =========================
    match /trips/{tripId} {
      allow read:
          if isSignedIn() &&
          (ownsExisting() || isAdmin());

      allow create:
          if isSignedIn() &&
          (ownsIncoming() || isAdmin());

      allow update:
          if isSignedIn() &&
          (ownsExisting() || isAdmin());

      allow delete:
          if isSignedIn() &&
          (ownsExisting() || isAdmin());
    }

    // =========================
    // TRUCKS
    // =========================
    match /trucks/{truckId} {
      allow read, write: if request.auth != null;
    }

    // =========================
    // EXPENSES
    // =========================
    match /expenses/{expenseId} {

      allow read:
          if isSignedIn() &&
          (
            ownsExisting() ||
            isPhoneMatch(resource.data.driverPhone) ||
            isAdmin()
          );

      allow create:
          if isSignedIn() &&
          (
            ownsIncoming() ||
            isPhoneMatch(request.resource.data.driverPhone) ||
            isAdmin()
          );

      allow update:
          if isSignedIn() &&
          (
            ownsExisting() ||
            isPhoneMatch(resource.data.driverPhone) ||
            isAdmin()
          );

      allow delete:
          if isSignedIn() &&
          (
            ownsExisting() ||
            isAdmin()
          );
    }

    // =========================
    // VENDORS
    // =========================
    match /vendors/{vendorId} {
      allow read:
          if isSignedIn();

      allow write:
          if isAdmin();
    }

    // =========================
    // NOTIFICATIONS
    // =========================
    match /notifications/{noteId} {

      allow read:
          if isSignedIn() &&
          isPhoneMatch(resource.data.toPhone);

      allow create:
          if isSignedIn() &&
          request.resource.data.toPhone is string;

      allow update:
          if isSignedIn() &&
          isPhoneMatch(resource.data.toPhone);

      allow delete:
          if isSignedIn() &&
          isPhoneMatch(resource.data.toPhone);
    }

    // =========================
    // SYSTEM
    // =========================
    match /system/{doc} {
      allow read:
          if isSignedIn();

      allow write:
          if isAdmin();
    }
  }
}