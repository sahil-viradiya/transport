rules_version = '2';

// Storage paths mirror the Firestore ownership model.
// Avatars:  avatars/{phone}.jpg
// POD:       proof_of_delivery/{ownerPhone}/{tripId}.jpg
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null && request.auth.token.phone_number != null;
    }

    function phone() {
      return request.auth.token.phone_number.replace('^\\+', '');
    }

    function isImageUnder(maxMb) {
      return request.resource.size < maxMb * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /avatars/{fileName} {
      allow read:  if request.auth != null;
      allow write: if isSignedIn()
        && fileName == phone() + '.jpg'
        && isImageUnder(5);
    }
 
    match /proof_of_delivery/{ownerId}/{fileName} {
      allow read:  if request.auth != null;
      allow write: if isSignedIn()
        && ownerId == phone()
        && isImageUnder(10);
    }
 
    match /loading_photos/{ownerId}/{fileName} {
      allow read:  if request.auth != null;
      allow write: if isSignedIn()
        && ownerId == phone()
        && isImageUnder(10);
    }
 
    match /gate_pass_photos/{ownerId}/{fileName} {
      allow read:  if request.auth != null;
      allow write: if isSignedIn()
        && ownerId == phone()
        && isImageUnder(10);
    }
 
    match /expense_receipts/{ownerId}/{fileName} {
      allow read:  if request.auth != null;
      allow write: if isSignedIn()
        && ownerId == phone()
        && isImageUnder(10);
    }
  }
}
