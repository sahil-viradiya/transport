rules_version = '2';

// Storage rules for Transport App bucket
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isFileUnder(maxMb) {
      return request.resource.size < maxMb * 1024 * 1024;
    }

    // Avatars
    match /avatars/{fileName} {
      allow read: if request.auth != null;
      allow write: if isSignedIn() && isFileUnder(10);
    }

    // Driver Documents
    match /driver_documents/{ownerId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if isSignedIn() && isFileUnder(10);
    }

    // Proof of Delivery (POD)
    match /proof_of_delivery/{ownerId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if isSignedIn() && isFileUnder(10);
    }

    // Loading Photos
    match /loading_photos/{ownerId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if isSignedIn() && isFileUnder(10);
    }

    // Gate Pass Photos
    match /gate_pass_photos/{ownerId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if isSignedIn() && isFileUnder(10);
    }

    // Expense Receipts
    match /expense_receipts/{ownerId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if isSignedIn() && isFileUnder(10);
    }

    // Truck Issues
    match /truck_issues/{ownerId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if isSignedIn() && isFileUnder(10);
    }
  }
}

